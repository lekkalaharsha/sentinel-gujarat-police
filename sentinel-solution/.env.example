# Copy to .env and fill in once sandbox access is granted.
# CDN host — serves HLS + cameras.json catalogue, behind your access password.
SENTINEL_CDN_HOST=cctv.corp8.cloud
# Public static IP (or dedicated subdomain) — serves RTSP/WHEP directly.
SENTINEL_STREAM_HOST=103.250.160.189
SENTINEL_ACCESS_TOKEN=
# Login page has both an email and a password field (form action /auth/login) —
# the password alone is not enough, despite the Control Room UI implying otherwise.
SENTINEL_ACCESS_EMAIL=
DATABASE_URL=sqlite:///./sentinel.db
